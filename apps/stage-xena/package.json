{
  "name": "@xena/stage-xena",
  "version": "0.6.0",
  "private": true,
  "type": "commonjs",
  "description": "Xena desktop overlay app (Electron)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && cross-env XENA_DEV=1 electron .",
    "start": "electron .",
    "dist": "node build.mjs && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@xena/inference-gateway": "workspace:*",
    "@xena/router9-client": "workspace:*",
    "@xena/tts": "workspace:*",
    "@xena/xena-core": "workspace:*",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.xena.app",
    "productName": "Xena",
    "executableName": "Xena",
    "icon": "assets/app-icon.ico",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "data/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Xena-setup-${version}.${ext}"
    }
  }
}

